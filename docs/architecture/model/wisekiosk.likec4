// WiseKiosk architecture model (ADR 0019 rev 7). Edit here, then `just arch-export`
// (ADR 0003 rev 4).
// A tag parses only as the first entry of a body. A `link` path resolves against this directory.

specification {
  element person {
    style {
      shape person
    }
  }
  element system
  element container
  element component

  // ADR 0019 rev 7
  deploymentNode host
  deploymentNode process
  deploymentNode artifact

  // Doorstop identifiers (ADR 0019 rev 7).
  tag SYS001
  tag SYS002
  tag SYS003
  tag SYS004
  tag SYS005
  tag SYS006
  tag SYS008
  tag SYS009
  tag SYS010
  tag SYS011
  tag SRS001
  tag SRS002
  tag SRS003
  tag SRS004
  tag SRS006
  tag SRS007
  tag SRS008
  tag SRS009
  tag SRS010
  tag SRS011
  tag SRS012
  tag SRS013
  tag SRS014
  tag SRS015
  tag SRS016
  tag SRS017
  tag SRS018
  tag SRS019
  tag SRS020
  tag SRS021
  tag SRS022
  tag SRS025
  tag SRS026
  tag SRS027
  tag SRS028
  tag SRS030
  tag SRS031
  tag SRS032
  tag SRS033
  tag SRS034
  tag SRS035
  tag SRS036
  tag SRS037
  tag SRS038
  tag SRS039
  tag SRS040
  tag SRS041
  tag SRS042
  tag SRS043
  tag SRS044
  tag SRS045
  tag SRS046
  tag SRS047
  tag SRS048
  tag SRS049
  tag SRS050
  tag SRS051
  tag SRS052
  tag SRS053
  tag SRS054
  tag SRS056
  tag SRS057
  tag SRS058
  tag SRS059
  tag SRS060
  tag SRS061
  tag SRS062
  tag SRS063
  tag SRS064
  tag SRS065
  tag SRS066
  tag SRS067
  tag SRS068
  tag SRS069
  tag SRS070
  tag SRS071
  tag SRS072
}

model {
  operator = person 'Operator' {
    description 'Deploys WiseKiosk, authors its configuration and supplies its secrets.'
  }

  viewer = person 'Viewer' {
    description 'Reads the display. Provides no input to the system.'
  }

  wisekiosk = system 'WiseKiosk' {
    description '''
      Full-screen, config-driven smart-mirror display. The boundary is what
      deploys: the published container image and what it serves.
    '''

    // ADR 0019 rev 7
    backend = container 'Backend' {
      #SYS004
      #SYS006
      #SRS006
      #SRS008
      #SRS009
      #SRS014
      #SRS022
      #SRS028
      link ../../../backend
      technology 'Go'
      icon tech:go
      description '''
        Stateless HTTP proxy and static file server. Answers one route per
        upstream source, shaping each response into the payload the boundary
        schema defines, and serves the frontend bundle and the configuration
        file as static content it never interprets.
      '''

      staticServing = component 'Static serving' {
        link ../../../backend/internal/staticserve
        description '''
          Serves the frontend bundle and the configuration file as bytes,
          interpreting neither. The configuration is not in the image and is
          read from the served tree on each request for it.
        '''
      }

      routeHandler = component 'Route handler' {
        #SRS009
        link ../../../backend/internal/router
        description '''
          Serves one route per upstream source. Owns the order the other
          parts run in, and calls the module's shaping functions to build the
          upstream request and to parse what comes back — the point where
          this container's framework half reaches its module half.
        '''
      }

      requestRejection = component 'Request rejection' {
        #SRS012
        #SRS013
        link ../../../backend/internal/router
        description '''
          Holds the rejection a request that does not conform is answered
          with: a status distinct to its cause, and a body the frontend can
          render, one shape for every route so no module composes its own. The
          judging is each module's, made against the constraint that module
          declares and before any upstream call is made, so the backend issues
          only the upstream requests its configuration calls for. It reads
          nothing about who is asking.
        '''
      }

      responseCache = component 'Response cache' {
        #SRS011
        link ../../../backend/internal/cache
        description '''
          Holds a route's last success and last failure, each for the interval
          that route's entry sets, so a display refresh no faster than the
          interval reaches no upstream.
        '''
      }

      upstreamClient = component 'Upstream client' {
        #SRS001
        #SRS006
        #SRS011
        #SRS014
        link ../../../backend/internal/upstream
        link ../../../backend/internal/ratelimit
        link ../../../backend/internal/secret
        description '''
          Makes the outbound request a route calls for, under that route's
          timeout, response-size ceiling and request-rate bound, and
          resolves the source's secret as it goes. Reports a failure by its
          cause, and a secret by its name.
        '''
      }

      weatherShaping = component 'Weather shaping' {
        #SRS043
        #SRS044
        link ../../../backend/internal/modules/weather
        description '''
          The weather module's half of this container. Serves the route the
          boundary schema declares for it: reads the location out of the
          request through the type generated from that schema, judges it
          against the constraint this module declares, builds the request for
          the weather source, and reshapes what comes back into the payload
          the module puts across the boundary — the present weather, whether
          it is day or night, and what is expected over the coming hours and
          days. Carries the policies its route runs under and hands the
          request to the framework pipeline that applies them. Its shaping is
          pure, reading nothing and calling nothing.
        '''
      }

      waitTimesShaping = component 'Wait-times shaping' {
        #SRS056
        #SRS066
        #SRS067
        #SRS068
        link ../../../backend/internal/modules/park_wait_times
        description '''
          The park-wait-times module's half of this container. Serves the route
          the boundary schema declares for it: reads the park out of the request
          through the type generated from that schema, judges it against the
          constraint this module declares, builds the request for the wait-times
          source, and reshapes what comes back into the payload the module puts
          across the boundary — each park's name and operating hours, and for
          every ride its name with its current wait or its not-operating state.
          Carries the policies its route runs under and hands the request to the
          framework pipeline that applies them. Its shaping is pure, reading
          nothing and calling nothing.
        '''
      }
    }

    frontend = container 'Frontend' {
      #SYS002
      #SYS008
      #SRS010
      #SRS017
      #SRS021
      #SRS027
      #SRS030
      #SRS032
      #SRS033
      #SRS040
      technology 'Svelte 5, static single-page bundle'
      icon tech:svelte
      description '''
        Runs in the browser on the display host. Validates the configuration
        before applying it, assembles the configured modules into one
        full-screen layout, and renders each payload into its module region.
        Everything it draws but the content itself is held under one emission
        ceiling, and the text it presents to be read is rendered at full
        emission and above one size floor read against the display's height.
      '''

      pageShell = component 'Page shell' {
        #SRS004
        #SRS026
        #SRS070
        description '''
          Loads and renders before any configuration is applied, so a
          configuration that cannot be applied at all is reported on a page
          that exists rather than on a blank one. Asks the backend whether it
          is still serving, and reports a backend that is not once for the
          page, beside the modules that need none. It keeps asking while the
          backend is gone, so the report is withdrawn on the page it was raised
          on once the backend answers again, without anybody attending the
          display.
        '''
      }

      configuration = component 'Configuration load and validation' {
        #SRS002
        description '''
          Fetches the configuration on each page load and validates it against
          the schema, reporting an error it can isolate as belonging to one
          module rather than to the configuration as a whole.
        '''
      }

      layout = component 'Layout assembly' {
        #SRS017
        #SRS031
        #SRS034
        #SRS035
        description '''
          Places each configured module into its region of one full-screen
          layout, and reflows rather than overlapping or scrolling sideways at
          narrower viewports. Holds every region out of the masked band along the
          display's edges, at the depth the configuration declares and none
          where it declares nothing. Content exceeding the region it was given
          overflows it rather than being clipped, scrolled or scaled.
        '''
      }

      moduleHost = component 'Module host' {
        #SRS026
        #SRS069
        #SRS070
        description '''
          Stands between the layout and one module's component, one host per
          placement. Fetches that module's payload on the module's own
          cadence, abandons a read that has not come back inside the deadline
          it gives one, and hands the component one of three states — not read
          yet, read, or read and unavailable — so a component is never handed
          nothing. A failure is passed on rather than absorbed: the structured
          body a module renders its own unavailable state from is what it
          receives. Whether the backend can be reached at all is not inferred
          here — the page shell decides that from its own liveness ask — but
          it is acted on: an unreachable backend stops the fetching, and what
          is held from before is dropped rather than drawn on as current, and a
          module held behind a fault is drawn again once the backend answers.
          A module that fails while rendering is caught here rather than at the
          region or the page, one catch per placement, and what stands in its
          place says only that it has stopped drawing — so a placement beside
          it, in its own region or sharing one, goes on rendering.
        '''
      }

      clock = component 'Clock' {
        #SYS009
        #SRS036
        #SRS037
        #SRS038
        #SRS039
        #SRS048
        description '''
          Renders the time of day into the region the configuration gives it,
          taken from the clock of the host running the browser and kept
          tracking real time for as long as the page stays loaded. Presents
          the hour in the form its configuration selects, and the seconds and
          the date beside it where the configuration asks for them. Fetches
          nothing, so a backend that is gone takes nothing from it.
        '''
      }

      weather = component 'Weather' {
        #SYS010
        #SRS042
        #SRS045
        #SRS046
        #SRS050
        #SRS051
        #SRS052
        #SRS053
        description '''
          Renders the weather into the region the configuration gives it: what
          it is doing now, and what is expected over the coming hours and the
          coming days, each told apart from the others, and each of the first
          two marked for whether it is a day's weather or a night's, following
          the distinction it is handed rather than working one out. Reports on
          the location its configuration names. It draws what it is given and
          fetches nothing: the reading is its host's, on the cadence that
          keeps what a viewer reads from falling far behind the source, and a
          backend that is gone stands this module down.
        '''
      }

      parkWaitTimes = component 'Park wait times' {
        #SYS011
        #SRS054
        #SRS057
        #SRS058
        #SRS059
        #SRS060
        #SRS061
        #SRS062
        #SRS071
        #SRS072
        description '''
          Renders the park wait times into the region the configuration gives
          it: a card for every configured park, all of them held on screen at
          once, each card keeping the park's longest current waits in view and
          touring the rest of its rides on a configured interval, every card
          with more than one page to show turning to its next at the same
          moment as the others rather than on a cadence of its own, and drawing
          each wait as the length of time or the not-operating state it is
          handed rather than deciding for itself whether a ride can be ridden.
          A card is one width whatever it holds, so a ride name the card leaves
          no room for is moved through its own column to bring the rest of it
          into view rather than widening the card or being cut off in place.
          Reports on the parks its configuration names, arranged in a grid its
          configuration shapes. It draws what it is given and fetches nothing:
          the reading is its host's, on the cadence that keeps what a viewer
          reads from falling far behind the source, and a backend that is gone
          stands this module down.
        '''
      }
    }

    // Deliberately server->client, terminating on a container (../../ARCHITECTURE.md § Frontend).
    staticServing -> frontend 'Serves the single-page bundle' {
      technology 'HTTP'
    }

    pageShell -> configuration 'Asks for the configuration, and applies it once it validates'
    pageShell -> layout 'Hands over the configured modules and whether the backend is serving'
    layout -> moduleHost 'Mounts one host per configured placement'

    routeHandler -> responseCache 'Asks for a held answer, and stores what it gets'
    routeHandler -> upstreamClient 'Asks for a fresh response when nothing is held'
    weatherShaping -> requestRejection 'Answers a request it will not carry with the shared rejection'

    configuration -> staticServing 'Fetches the configuration, served back unparsed' {
      #SRS003
      technology 'HTTP'
    }

    moduleHost -> routeHandler 'Fetches the payload for each module' {
      #SYS004
      #SYS005
      #SRS013
      #SRS015
      #SRS016
      technology 'HTTP / JSON'
    }
  }

  openMeteo = system 'Open-Meteo' {
    description '''
      The weather service the weather module reads. Run by somebody else and
      outside the boundary. Which service this is, is an edit to this
      repository: no requirement names it, and the module's obligations are
      written against a weather source rather than against this one.
    '''
  }

  upstreamClient -> openMeteo 'Fetches the weather for the location a request names' {
    #SRS041
    #SRS047
    #SRS049
    technology 'HTTPS'
  }

  themeParksWiki = system 'themeparks.wiki' {
    description '''
      The wait-times service the park-wait-times module reads. Run by somebody
      else and outside the boundary. Which service this is, is an edit to this
      repository: no requirement names it, and the module's obligations are
      written against a wait-times source rather than against this one.
    '''
  }

  upstreamClient -> themeParksWiki 'Fetches the wait times for the parks a request names' {
    #SRS065
    #SRS063
    #SRS064
    technology 'HTTPS'
  }

  operator -> upstreamClient 'Supplies the secret for each source' {
    #SYS003
  }

  operator -> staticServing 'Places the configuration into the served tree' {
    #SYS003
    #SRS007
  }

  frontend -> viewer 'Renders the configured modules, legibly says when one failed, and mirrors the rest' {
    #SYS001
    #SRS001
    #SRS002
    #SRS004
    #SRS026
  }
}
